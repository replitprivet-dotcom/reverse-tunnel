[Unit]
Description=Reverse Tunnel client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tunnel
Group=tunnel
EnvironmentFile=/etc/reverse-tunnel/client.env
ExecStart=/usr/local/bin/tunnel-client
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
