[Unit]
Description=Reverse Tunnel dashboard and one-command installer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tunnel
Group=tunnel
EnvironmentFile=/etc/reverse-tunnel/panel.env
ExecStart=/usr/local/bin/tunnel-panel
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/etc/reverse-tunnel /opt/reverse-tunnel

[Install]
WantedBy=multi-user.target
