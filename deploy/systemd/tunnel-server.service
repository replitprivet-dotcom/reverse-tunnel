[Unit]
Description=Reverse Tunnel public server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tunnel
Group=tunnel
EnvironmentFile=/etc/reverse-tunnel/server.env
ExecStart=/usr/local/bin/tunnel-server
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
